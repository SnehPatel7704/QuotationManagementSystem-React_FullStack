# Database Configuration
# Replace username, password, and quotation_db with your MySQL credentials
DATABASE_URL="mysql://username:password@localhost:3306/quotation_db"

# JWT Configuration
JWT_SECRET="your-jwt-secret-key-change-in-production"

# Server Configuration
PORT=8080
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# Mail Configuration (Gmail SMTP)
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM=""

# Set these only for the one-time production administrator bootstrap command.
BOOTSTRAP_ADMIN_USERNAME=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
